{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palleria.invalid/schemas/pallasync-v1.schema.json",
  "title": "PallaSync Protocol 1.0 Core Schema",
  "type": "object",
  "$defs": {
    "base64url43": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "chainVector": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/base64url43"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "requestEnvelope": {
      "type": "object",
      "required": [
        "protocol_version",
        "message_type",
        "request_id",
        "chain_id",
        "device_id",
        "issued_at_ms",
        "expires_at_ms",
        "nonce",
        "critical",
        "body",
        "signature"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "message_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "chain_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "body": {
          "type": "object"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "additionalProperties": true
    },
    "deviceCertificate": {
      "type": "object",
      "required": [
        "protocol_version",
        "certificate_id",
        "chain_id",
        "device_id",
        "device_sign_public_key",
        "device_hpke_public_key",
        "role",
        "capabilities",
        "issued_at_ms",
        "not_before_ms",
        "not_after_ms",
        "issuer",
        "critical",
        "signature"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "certificate_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "chain_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_sign_public_key": {
          "$ref": "#/$defs/base64url43"
        },
        "device_hpke_public_key": {
          "$ref": "#/$defs/base64url43"
        },
        "role": {
          "enum": [
            "admin",
            "member"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "not_before_ms": {
          "type": "integer",
          "minimum": 0
        },
        "not_after_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "root",
                "device"
              ]
            },
            "device_id": {
              "$ref": "#/$defs/base64url43"
            }
          },
          "additionalProperties": false
        },
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "additionalProperties": true
    },
    "dataPayload": {
      "type": "object",
      "required": [
        "schema",
        "entity_id",
        "operation",
        "context",
        "lamport",
        "created_at_ms",
        "body"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+/[0-9]+$"
        },
        "entity_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "operation": {
          "enum": [
            "upsert",
            "delete"
          ]
        },
        "context": {
          "$ref": "#/$defs/chainVector"
        },
        "lamport": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "body": {}
      },
      "additionalProperties": true
    },
    "dataEvent": {
      "type": "object",
      "required": [
        "protocol_version",
        "chain_id",
        "device_id",
        "device_seq",
        "prev_event_hash",
        "key_epoch",
        "event_type",
        "ciphertext",
        "signature",
        "event_hash"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "chain_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "prev_event_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/base64url43"
            },
            {
              "type": "null"
            }
          ]
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "event_type": {
          "const": "data"
        },
        "ciphertext": {
          "$ref": "#/$defs/base64url"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "event_hash": {
          "$ref": "#/$defs/base64url43"
        }
      },
      "additionalProperties": false
    },
    "signalingEvent": {
      "type": "object",
      "required": [
        "protocol_version",
        "event_id",
        "session_id",
        "chain_id",
        "from_device_id",
        "to_device_id",
        "event_type",
        "revision",
        "created_at_ms",
        "expires_at_ms",
        "payload",
        "signature"
      ],
      "properties": {
        "protocol_version": {
          "const": "2.0"
        },
        "event_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "session_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "chain_id": {
          "$ref": "#/$defs/base64url43"
        },
        "from_device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "to_device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "event_type": {
          "enum": [
            "offer",
            "answer",
            "ice-candidate",
            "ice-end",
            "ice-restart",
            "close",
            "error"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "offer"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/signalingOffer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "answer"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/signalingAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "ice-candidate"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/signalingIceCandidate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "ice-end"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "ice-restart"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "close"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "p2pHello": {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "session_id",
        "chain_id",
        "device_id",
        "certificate",
        "control_seq",
        "control_hash",
        "nonce",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "p2p.hello"
        },
        "protocol": {
          "const": "pallasync/1"
        },
        "session_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "chain_id": {
          "$ref": "#/$defs/base64url43"
        },
        "device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "certificate": {
          "$ref": "#/$defs/deviceCertificate"
        },
        "control_seq": {
          "type": "integer",
          "minimum": 1
        },
        "control_hash": {
          "$ref": "#/$defs/base64url43"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "additionalProperties": false
    },
    "signalingOffer": {
      "type": "object",
      "required": [
        "sdp"
      ],
      "properties": {
        "sdp": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "signalingAnswer": {
      "type": "object",
      "required": [
        "sdp",
        "offer_hash"
      ],
      "properties": {
        "sdp": {
          "type": "string"
        },
        "offer_hash": {
          "$ref": "#/$defs/base64url43"
        }
      },
      "additionalProperties": false
    },
    "signalingIceCandidate": {
      "type": "object",
      "required": [
        "candidate",
        "remote_description_hash",
        "sdp_mid",
        "sdp_mline_index"
      ],
      "properties": {
        "candidate": {
          "type": "string"
        },
        "remote_description_hash": {
          "$ref": "#/$defs/base64url43"
        },
        "sdp_mid": {
          "type": "string"
        },
        "sdp_mline_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "peerPresence": {
      "type": "object",
      "required": [
        "device_id",
        "online",
        "last_seen_ms",
        "capabilities",
        "signaling_generation"
      ],
      "properties": {
        "device_id": {
          "$ref": "#/$defs/base64url43"
        },
        "online": {
          "type": "boolean"
        },
        "last_seen_ms": {
          "type": "integer"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signaling_generation": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "p2pPing": {
      "type": "object",
      "required": [
        "type",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "ping"
        },
        "timestamp": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "p2pPong": {
      "type": "object",
      "required": [
        "type",
        "timestamp"
      ],
      "properties": {
        "type": {
          "const": "pong"
        },
        "timestamp": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "p2pCapabilities": {
      "type": "object",
      "required": [
        "type",
        "pallasync_versions",
        "max_frame_size",
        "max_batch_events",
        "compression",
        "schemas"
      ],
      "properties": {
        "type": {
          "const": "capabilities"
        },
        "pallasync_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_frame_size": {
          "type": "integer"
        },
        "max_batch_events": {
          "type": "integer"
        },
        "compression": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "syncBegin": {
      "type": "object",
      "required": [
        "type",
        "sync_id",
        "chain_vector",
        "control_seq",
        "control_hash",
        "key_epoch"
      ],
      "properties": {
        "type": {
          "const": "sync.begin"
        },
        "sync_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "chain_vector": {
          "$ref": "#/$defs/chainVector"
        },
        "control_seq": {
          "type": "integer"
        },
        "control_hash": {
          "$ref": "#/$defs/base64url43"
        },
        "key_epoch": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "syncRequest": {
      "type": "object",
      "required": [
        "type",
        "ranges"
      ],
      "properties": {
        "type": {
          "const": "sync.request"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "from_seq",
              "to_seq"
            ],
            "properties": {
              "device_id": {
                "$ref": "#/$defs/base64url43"
              },
              "from_seq": {
                "type": "integer"
              },
              "to_seq": {
                "type": "integer"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "eventBatch": {
      "type": "object",
      "required": [
        "type",
        "batch_id",
        "events",
        "final"
      ],
      "properties": {
        "type": {
          "const": "event.batch"
        },
        "batch_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataEvent"
          }
        },
        "final": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "eventAck": {
      "type": "object",
      "required": [
        "type",
        "batch_id",
        "accepted_vector",
        "rejected"
      ],
      "properties": {
        "type": {
          "const": "event.ack"
        },
        "batch_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "accepted_vector": {
          "$ref": "#/$defs/chainVector"
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sessionClose": {
      "type": "object",
      "required": [
        "type",
        "reason",
        "final_vector",
        "control_seq",
        "control_hash"
      ],
      "properties": {
        "type": {
          "const": "session.close"
        },
        "reason": {
          "type": "string"
        },
        "final_vector": {
          "$ref": "#/$defs/chainVector"
        },
        "control_seq": {
          "type": "integer"
        },
        "control_hash": {
          "$ref": "#/$defs/base64url43"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/requestEnvelope"
    },
    {
      "$ref": "#/$defs/deviceCertificate"
    },
    {
      "$ref": "#/$defs/dataPayload"
    },
    {
      "$ref": "#/$defs/dataEvent"
    },
    {
      "$ref": "#/$defs/signalingEvent"
    },
    {
      "$ref": "#/$defs/p2pHello"
    },
    {
      "$ref": "#/$defs/peerPresence"
    },
    {
      "$ref": "#/$defs/p2pPing"
    },
    {
      "$ref": "#/$defs/p2pPong"
    },
    {
      "$ref": "#/$defs/p2pCapabilities"
    },
    {
      "$ref": "#/$defs/syncBegin"
    },
    {
      "$ref": "#/$defs/syncRequest"
    },
    {
      "$ref": "#/$defs/eventBatch"
    },
    {
      "$ref": "#/$defs/eventAck"
    },
    {
      "$ref": "#/$defs/sessionClose"
    }
  ]
}
